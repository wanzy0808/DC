generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  OWNER
  FINANCE
  DESIGNER
  EDITOR
}

enum InvitationType {
  WEDDING
  ADAT_AKAD
}

enum InvitationAssetType {
  IMAGE
  AUDIO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model User {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  passwordHash       String
  firstName          String
  lastName           String?
  phone              String?
  role               UserRole               @default(USER)
  emailVerified      Boolean                @default(false)
  emailVerifiedAt    DateTime?
  termsAcceptedAt    DateTime?
  privacyAcceptedAt  DateTime?
  marketingConsent   Boolean                @default(false)
  accountStatus      String                 @default("ACTIVE")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  sessions           UserSession[]
  verificationTokens VerificationToken[]
  resetTokens        PasswordResetToken[]
  actionTokens       AccountActionToken[]   @relation("ActionTokenUser")
  invitations        Invitation[]
  payments           Payment[]
  orders             PaymentOrder[]
  invitationAssets   InvitationAsset[]
  auditLogs          AuditLog[]             @relation("AuditLogActor")
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccountActionToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  action    String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation("ActionTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action])
}

model Invitation {
  id                 String            @id @default(cuid())
  ownerId            String
  slug               String            @unique
  type               InvitationType
  title              String
  eventCategory      String            @default("OTHER")
  templateKey        String            @default("")
  groomName          String            @default("")
  brideName          String            @default("")
  groomFatherName    String?
  groomMotherName    String?
  groomChildOrder    Int?
  brideFatherName    String?
  brideMotherName    String?
  brideChildOrder    Int?
  venue              String            @default("")
  address            String?
  mapUrl             String?
  timezone           String            @default("Asia/Jakarta")
  eventDate          DateTime          @default(now())
  eventConfigured    Boolean           @default(false)
  ceremonyTime       String?
  receptionTime      String?
  description        String?           @db.Text
  weddingHashtag     String?
  dressCode          String?
  liveStreamUrl      String?
  eventNotes         String?           @db.Text
  giftBankName       String?
  giftAccountName    String?
  giftAccountNumber  String?
  musicUrl           String?
  isPublished        Boolean           @default(false)
  passwordProtected  Boolean           @default(false)
  passwordHash       String?
  viewCount          Int               @default(0)
  waBlastQuota       Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payment            Payment?
  orders             PaymentOrder[]
  assets             InvitationAsset[]
  tables             WeddingTable[]
  guests             Guest[]

  @@index([ownerId, type])
}

model InvitationAsset {
  id           String              @id @default(cuid())
  invitationId String
  type         InvitationAssetType
  url          String
  title        String?
  createdAt    DateTime            @default(now())
  invitation   Invitation          @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String

  @@index([invitationId, type])
  @@index([ownerId])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  invitationId  String        @unique
  packageKey    String        @default("INVITATION_BASIC")
  status        PaymentStatus @default(PENDING)
  amount        Int           @default(0)
  provider      String        @default("manual")
  externalRef   String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation    Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  proofUrl      String?
  note          String?       @db.Text
  confirmedAt   DateTime?
  confirmedById String?
}

model PaymentOrder {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique
  userId        String
  invitationId  String
  packageKey    String
  amount        Int
  status        OrderStatus @default(PENDING)
  provider      String      @default("manual")
  proofUrl      String?
  note          String?     @db.Text
  paidAt        DateTime?
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation    Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([invitationId, createdAt])
}

model WeddingTable {
  id           String     @id @default(cuid())
  invitationId String
  name         String
  shape        String     @default("ROUND")
  capacity     Int        @default(10)
  positionX    Float      @default(0)
  positionY    Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guests       Guest[]

  @@index([invitationId])
  @@unique([invitationId, name])
}

model Guest {
  id                    String        @id @default(cuid())
  invitationId          String
  name                  String
  phone                 String?
  email                 String?
  rsvpStatus            String        @default("PENDING")
  plusOnes              Int           @default(0)
  notes                 String?       @db.Text
  qrCode                String?       @unique
  checkedIn             Boolean       @default(false)
  checkedInAt           DateTime?
  tableId               String?
  seatNumber            Int?
  personalToken         String?       @unique
  personalPublished     Boolean       @default(false)
  personalPasswordHash  String?
  personalViewCount     Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  invitation            Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  table                 WeddingTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@index([invitationId, rsvpStatus])
  @@index([invitationId, checkedIn])
  @@unique([tableId, seatNumber])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
