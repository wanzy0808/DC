generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  EDITOR
  DESIGNER
  SUPPORT
  FINANCE
  OWNER
  ADMIN
}

enum InvitationType {
  WEDDING
  ADAT_AKAD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum InvitationAssetType {
  IMAGE
  AUDIO
}

enum RsvpStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
  TENTATIVE
}

enum GuestSource {
  RSVP
  MANUAL
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  firstName          String
  lastName           String?
  role               UserRole                 @default(USER)
  emailVerifiedAt    DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  invitations        Invitation[]
  invitationAssets   InvitationAsset[]
  payments           Payment[]
  orders             PaymentOrder[]
  auditLogs          AuditLog[]               @relation("ActorLogs")
  guestCheckIns      Guest[]                  @relation("GuestCheckInActor")
  designerTemplates  DesignerTemplate[]       @relation("TemplateDesigner")
  actionTokens       AccountActionToken[]     @relation("ActionTokenUser")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccountActionToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  action    String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation("ActionTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action])
}

model Invitation {
  id                 String            @id @default(cuid())
  ownerId            String
  slug               String            @unique
  type               InvitationType
  title              String
  eventCategory      String            @default("OTHER")
  templateKey        String            @default("")
  groomName          String            @default("")
  brideName          String            @default("")
  groomFatherName    String?
  groomMotherName    String?
  groomChildOrder    Int?
  brideFatherName    String?
  brideMotherName    String?
  brideChildOrder    Int?
  venue              String            @default("")
  address            String?
  mapUrl             String?
  timezone           String            @default("Asia/Jakarta")
  eventDate          DateTime          @default(now())
  eventConfigured    Boolean           @default(false)
  ceremonyTime       String?
  receptionTime      String?
  weddingCeremonyEnabled Boolean @default(false)
  weddingReceptionEnabled Boolean @default(false)
  weddingCeremonyStart String?
  weddingCeremonyEnd String?
  weddingCeremonyVenue String?
  weddingCeremonyAddress String?
  weddingCeremonyMapUrl String?
  weddingReceptionStart String?
  weddingReceptionEnd String?
  weddingReceptionVenue String?
  weddingReceptionAddress String?
  weddingReceptionMapUrl String?
  description        String?           @db.Text
  weddingHashtag     String?
  dressCode          String?
  liveStreamUrl      String?
  eventNotes         String?           @db.Text
  giftBankName       String?
  giftAccountName    String?
  giftAccountNumber  String?
  musicUrl           String?
  isPublished        Boolean           @default(false)
  passwordProtected  Boolean           @default(false)
  passwordHash       String?
  viewCount          Int               @default(0)
  waBlastQuota       Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payment            Payment?
  orders             PaymentOrder[]
  assets             InvitationAsset[]
  tables             WeddingTable[]
  guests             Guest[]

  @@index([ownerId, type])
}

model InvitationAsset {
  id           String              @id @default(cuid())
  invitationId String
  type         InvitationAssetType
  url          String
  title        String?
  createdAt    DateTime            @default(now())
  invitation   Invitation          @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String

  @@index([invitationId, type])
  @@index([ownerId])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  invitationId  String        @unique
  packageKey    String        @default("INVITATION_BASIC")
  status        PaymentStatus @default(PENDING)
  amount        Int           @default(0)
  provider      String        @default("manual")
  externalRef   String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation    Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  proofUrl      String?
  note          String?       @db.Text
  confirmedAt   DateTime?
  confirmedById String?
}

model PaymentOrder {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique
  userId        String
  invitationId  String
  packageKey    String
  amount        Int
  status        OrderStatus @default(PENDING)
  provider      String      @default("manual")
  proofUrl      String?
  note          String?     @db.Text
  paidAt        DateTime?
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation    Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([invitationId, createdAt])
  @@index([status, createdAt])
}

model DesignerTemplate {
  id            String         @id @default(cuid())
  templateNo    String         @unique
  name          String
  tags          String[]
  previewUrl    String
  templateFile  String
  status        TemplateStatus @default(PUBLISHED)
  designerId    String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  designer      User           @relation("TemplateDesigner", fields: [designerId], references: [id], onDelete: Cascade)

  @@index([designerId, createdAt])
  @@index([status, createdAt])
}

model WeddingTable {
  id           String     @id @default(cuid())
  invitationId String
  name         String
  shape        String     @default("ROUND")
  capacity     Int        @default(8)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guests       Guest[]

  @@index([invitationId])
}

model Guest {
  id                        String        @id @default(cuid())
  invitationId              String
  tableId                   String?
  seatNumber                Int?
  name                      String
  phone                     String?
  category                  String?
  tags                      String[]      @default([])
  source                    GuestSource   @default(MANUAL)
  rsvpStatus                RsvpStatus    @default(PENDING)
  plusOnes                  Int           @default(0)
  checkedIn                 Boolean       @default(false)
  checkedInAt               DateTime?
  checkedInById             String?
  waBlastSelected           Boolean       @default(false)
  waBlastSentAt             DateTime?
  personalToken             String?       @unique
  personalPublished         Boolean       @default(false)
  personalPasswordProtected Boolean       @default(false)
  personalPasswordHash      String?
  personalViewCount         Int           @default(0)
  weddingSessionAccess      String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  invitation                Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  table                     WeddingTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  checkedInBy               User?         @relation("GuestCheckInActor", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@index([invitationId, rsvpStatus])
  @@index([invitationId, category])
  @@index([invitationId, tableId])
  @@index([invitationId, waBlastSelected])
  @@index([invitationId, personalPublished])
  @@unique([tableId, seatNumber])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}
