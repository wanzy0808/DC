DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dc?schema=public"
APP_URL="http://localhost:3000"
INVITATION_ROOT_DOMAIN="dcwedding.com"
NEXT_PUBLIC_INVITATION_ROOT_DOMAIN="dcwedding.com"
SESSION_COOKIE_NAME="doc_session"
QR_SIGNING_SECRET="replace-with-a-long-random-secret"
INVITATION_PASSWORD_SECRET="replace-with-a-different-long-random-secret"

# Google OAuth (server-side only): create a Google Auth Platform OAuth client
# of type "Web application". For APP_URL=http://localhost:3000, register exactly:
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Do not put credentials in NEXT_PUBLIC_* variables or commit real values.
# Keep the sign-in browser origin, APP_URL, OAuth callback and cookie origin consistent.
# These are intentionally blank: login with Google requires YOUR own credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Manual payment / invoice
PAYMENT_BANK_NAME=""
PAYMENT_BANK_ACCOUNT=""
PAYMENT_BANK_HOLDER=""

# Optional invoice email via Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Owner security confirmation destination. Falls back to the current Owner email when empty.
OWNER_CONFIRMATION_EMAIL=""
